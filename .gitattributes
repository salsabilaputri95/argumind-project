# Mark documentation & design preview files so they do not skew language stats
*.html linguist-documentation=true
*.md linguist-documentation=true

# Ensure source languages are explicitly detectable by GitHub Linguist
*.py linguist-detectable=true
*.ts linguist-detectable=true
*.tsx linguist-detectable=true
*.sql linguist-detectable=true
*.css linguist-detectable=true

# Enforce LF line endings on corpus data and SHA-256 manifests across Windows & Linux/Colab
*.jsonl text eol=lf
*.sha256 text eol=lf
